<Application x:Class="KeyPulse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KeyPulse"
             xmlns:config="clr-namespace:KeyPulse.Configuration">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <config:ThemeResources />
                <ResourceDictionary Source="Views/Styles/ThemeControls.xaml" />
                <ResourceDictionary Source="Views/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
