<UserControl
  x:Class="KeyPulse.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:config="clr-namespace:KeyPulse.Configuration"
  xmlns:local="clr-namespace:KeyPulse.Views"
  Height="Auto"
  Width="Auto"
>
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="StorageOptionStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Card"
              Padding="12"
              Background="{DynamicResource WindowBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="5"
            >
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceBrush}" />
              </Trigger>

              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Width="460" HorizontalAlignment="Left" Margin="0,0,0,32">

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <iconPacks:PackIconPhosphorIcons Kind="Gear" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="General" Style="{StaticResource SectionTitleStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SectionDividerStyle}" />

            <CheckBox
              Content="Dark mode"
              IsChecked="{Binding DarkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Margin="0,0,0,10"
            />

            <CheckBox
              Content="Launch on login"
              IsChecked="{Binding LaunchOnLogin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Margin="0,0,0,10"
            />

            <CheckBox
              Content="Keep running in the background when closed"
              IsChecked="{Binding CloseToTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Visibility="{Binding ShowCloseToTrayOption, Converter={StaticResource BoolToVisibility}}"
              Margin="0,0,0,10"
            />

            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Keep per-minute activity for:" VerticalAlignment="Center" />
              <ComboBox
                Margin="8,0,0,0"
                Width="120"
                ItemsSource="{Binding RetentionChoices}"
                SelectedItem="{Binding SelectedRetentionOption, Mode=TwoWay}"
                DisplayMemberPath="Label"
              />
              <local:InfoHint
                Text="Limits how long a minute-by-minute record of your input activity is stored, for privacy reasons and to keep the database compact. Charts, calendar history, and lifetime totals are unaffected."
                Margin="6,0,0,0"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <iconPacks:PackIconPhosphorIcons Kind="Database" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="Storage" Style="{StaticResource SectionTitleStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SectionDividerStyle}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <RadioButton
                Grid.Column="0"
                GroupName="StorageProvider"
                Style="{StaticResource StorageOptionStyle}"
                IsChecked="{Binding UseSqliteStorage, Mode=TwoWay}"
              >
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconSimpleIcons Kind="SqLite" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource SqliteLogoBrush}" />
                  <TextBlock Text="SQLite" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <TextBlock
                    Text="In use"
                    Visibility="{Binding IsSqliteActive, Converter={StaticResource BoolToVisibility}}"
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="11"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                  />
                </StackPanel>
              </RadioButton>
              <RadioButton
                Grid.Column="1"
                GroupName="StorageProvider"
                Style="{StaticResource StorageOptionStyle}"
                Margin="0"
                IsChecked="{Binding UsePostgreSqlStorage, Mode=TwoWay}"
              >
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconSimpleIcons Kind="PostgreSql" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource PostgreSqlLogoBrush}" />
                  <TextBlock Text="PostgreSQL" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <TextBlock
                    Text="In use"
                    Visibility="{Binding IsPostgreSqlActive, Converter={StaticResource BoolToVisibility}}"
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="11"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                  />
                </StackPanel>
              </RadioButton>
            </Grid>

            <!-- Sized to the tallest state so switching providers does not resize the card. -->
            <StackPanel MinHeight="46">
              <Grid
                Visibility="{Binding ShowPostgreSqlSummary, Converter={StaticResource BoolToVisibility}}"
                Margin="0,12,0,0"
              >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding PostgreSqlSummary}" TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Text="{Binding PostgreSqlSslSummary}"
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="11"
                    Margin="0,3,0,0"
                  />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Test" Command="{Binding TestDatabaseConnectionCommand}" Padding="10,3" Margin="8,0,0,0" />
                  <Button Content="Edit" Padding="10,3" Margin="8,0,0,0" Click="OnEditDatabaseConnectionClick" />
                </StackPanel>
              </Grid>

              <StackPanel
                Visibility="{Binding ShowPostgreSqlForm, Converter={StaticResource BoolToVisibility}}"
                Margin="0,12,0,0"
              >
                <TextBlock
                  Text="Host, port, and database stay fixed while PostgreSQL is in use. Switch to SQLite first to point KeyPulse at a different database."
                  Visibility="{Binding IsPostgreSqlActive, Converter={StaticResource BoolToVisibility}}"
                  Foreground="{DynamicResource MutedBrush}"
                  FontSize="11"
                  TextWrapping="Wrap"
                  Margin="0,0,0,10"
                />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,6,6" />
                  <TextBox Grid.Row="0" Grid.Column="1" IsEnabled="{Binding CanEditConnectionTarget}" Text="{Binding PostgreSqlHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="0,0,6,6" />
                  <TextBox Grid.Row="0" Grid.Column="3" IsEnabled="{Binding CanEditConnectionTarget}" Text="{Binding PostgreSqlPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Database" VerticalAlignment="Center" Margin="0,0,6,6" />
                  <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" IsEnabled="{Binding CanEditConnectionTarget}" Text="{Binding PostgreSqlDatabase, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,6,6" />
                  <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PostgreSqlUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,6,6" />
                  <PasswordBox x:Name="PostgreSqlPasswordBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" PasswordChanged="OnPostgreSqlPasswordChanged" Margin="0,0,0,6" />

                  <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Text="Leave blank to keep the saved password."
                    Visibility="{Binding IsPostgreSqlActive, Converter={StaticResource BoolToVisibility}}"
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="11"
                    Margin="0,0,0,8"
                  />

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="SSL mode" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left" ItemsSource="{Binding PostgreSqlSslModeChoices}" SelectedItem="{Binding PostgreSqlSslMode}" />
                  <Button Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Content="Test" Command="{Binding TestDatabaseConnectionCommand}" Padding="10,3" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>

              <StackPanel
                Orientation="Horizontal"
                Margin="0,12,0,0"
                Visibility="{Binding ShowDatabaseActions, Converter={StaticResource BoolToVisibility}}"
              >
                <Button
                  Content="Apply on restart"
                  Command="{Binding ApplyDatabaseCommand}"
                  Padding="12,4"
                  Margin="0,0,8,0"
                />
                <Button Content="Cancel" Padding="12,4" Click="OnCancelDatabaseChangesClick" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <iconPacks:PackIconPhosphorIcons Kind="ArrowsClockwise" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="Updates" Style="{StaticResource SectionTitleStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SectionDividerStyle}" />

            <CheckBox
              Content="Install updates automatically"
              IsChecked="{Binding AutoInstallUpdates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Margin="0,0,0,12"
            />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{Binding CurrentVersionDisplay}" VerticalAlignment="Center" />

              <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Margin="8,0,0,0"
                Padding="10,4"
                Command="{Binding UpdateActionCommand}"
                Content="{Binding UpdateActionButtonText}"
              />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <local:ToastMessagePanel
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Margin="0,0,0,8"
      ToastMessage="{Binding ToastMessage}"
      ToastVisibility="{Binding ToastVisibility}"
    />
  </Grid>
</UserControl>
