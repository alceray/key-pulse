<UserControl
  x:Class="KeyPulse.Views.DashboardView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:oxy="http://oxyplot.org/wpf"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:config="clr-namespace:KeyPulse.Configuration"
  xmlns:local="clr-namespace:KeyPulse.Views"
  Height="Auto"
  Width="Auto"
>
  <UserControl.Resources>
    <local:PauseStateToIconKindConverter x:Key="PauseStateToIconKindConverter" />
    <local:PauseStateToActionTextConverter x:Key="PauseStateToActionTextConverter" />
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <UniformGrid Columns="3" Margin="0,0,0,6">
        <Border Style="{StaticResource StatCardStyle}">
          <StackPanel>
            <TextBlock Text="Connected Devices" FontWeight="Bold" />
            <TextBlock Text="{Binding ConnectedDevices}" FontSize="20" />
            <TextBlock
              Text="{Binding ConnectedDevicesBreakdown}"
              Foreground="{DynamicResource SecondaryTextBrush}"
              Margin="0,4,0,0"
            />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource StatCardStyle}">
          <StackPanel>
            <TextBlock Text="Most Connected Keyboards of All Time" FontWeight="Bold" />
            <TextBlock Text="{Binding TopKeyboardsSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource StatCardStyle}">
          <StackPanel>
            <TextBlock Text="Most Connected Mice of All Time" FontWeight="Bold" />
            <TextBlock Text="{Binding TopMiceSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid Margin="4,0,4,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox
          Grid.Column="0"
          Width="120"
          Margin="0,0,8,0"
          ItemsSource="{Binding RangeOptions}"
          SelectedItem="{Binding SelectedRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          VerticalAlignment="Center"
        />

        <TextBlock
          Grid.Column="1"
          Text="{Binding RangeDisplayText}"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Foreground="{DynamicResource SecondaryTextBrush}"
          FontWeight="SemiBold"
        />

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock
            Text="{Binding LastUpdatedText}"
            VerticalAlignment="Center"
            Foreground="{DynamicResource SecondaryTextBrush}"
          />
          <Button
            Margin="4,0,0,0"
            Command="{Binding RefreshCommand}"
            ToolTip="Refresh"
            VerticalAlignment="Center"
            Style="{StaticResource RoundHoverIconButtonStyle}"
          >
            <iconPacks:PackIconPhosphorIcons
              Kind="ArrowClockwise"
              VerticalAlignment="Center"
              Foreground="{DynamicResource SecondaryTextBrush}"
            />
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <oxy:PlotView
        Grid.Row="0"
        Grid.Column="0"
        Margin="4"
        Model="{Binding KeyboardPiePlot}"
        Controller="{Binding PieHoverController}"
        PreviewMouseMove="PlotView_PreviewMouseMove"
      />
      <oxy:PlotView
        Grid.Row="0"
        Grid.Column="1"
        Margin="4"
        Model="{Binding MousePiePlot}"
        Controller="{Binding PieHoverController}"
        PreviewMouseMove="PlotView_PreviewMouseMove"
      />

      <oxy:PlotView
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Margin="4"
        Model="{Binding InputActivityPlot}"
        Controller="{Binding ActivityChartController}"
        PreviewMouseMove="PlotView_PreviewMouseMove"
      />

      <!-- Overlaid in the plot's cell so it claims no layout space; right margin matches the chart and
           the top control bar, so its right edge lines up with the Refresh button above. -->
      <Button
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,8,4,0"
        Command="{Binding ToggleTrackingPauseCommand}"
        ToolTip="{Binding IsTrackingPaused, Converter={StaticResource PauseStateToActionTextConverter}}"
        Style="{StaticResource RoundHoverIconButtonStyle}"
      >
        <iconPacks:PackIconPhosphorIcons
          Kind="{Binding IsTrackingPaused, Converter={StaticResource PauseStateToIconKindConverter}}"
          VerticalAlignment="Center"
          Foreground="{DynamicResource SecondaryTextBrush}"
        />
      </Button>
    </Grid>
  </Grid>
</UserControl>
