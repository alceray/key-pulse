<Window
  x:Class="KeyPulse.Views.DatabaseSetupWindow"
  Style="{StaticResource AppWindowStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="520"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterScreen"
>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock x:Name="HeadingText" Text="Choose where KeyPulse stores data" FontSize="18" />
      <TextBlock
        x:Name="DescriptionText"
        Margin="0,6,0,0"
        Text="SQLite is recommended for most people. PostgreSQL is available when you manage your own database server."
        TextWrapping="Wrap"
      />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <StackPanel x:Name="RecoveryConnectionPanel" Visibility="Collapsed" Margin="0,0,0,12">
        <TextBlock Text="Connection to correct" Margin="0,0,0,4" />
        <ComboBox x:Name="RecoveryConnectionComboBox" SelectionChanged="OnRecoveryConnectionChanged" />
      </StackPanel>
      <RadioButton x:Name="SqliteRadio" Content="SQLite (recommended)" IsChecked="True" Checked="OnProviderChanged" />
      <TextBlock Margin="24,3,0,10" Text="Private local file, no setup required." Foreground="{DynamicResource SecondaryTextBrush}" />
      <RadioButton x:Name="PostgreSqlRadio" Content="PostgreSQL" Checked="OnProviderChanged" />
      <TextBlock Margin="24,3,0,0" Text="Connect to a dedicated database you created and manage." Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <Grid x:Name="PostgreSqlPanel" Grid.Row="2" Visibility="Collapsed" Margin="24,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox x:Name="HostTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" />
      <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Database" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox x:Name="DatabaseTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox x:Name="UsernameTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,8,8" />
      <PasswordBox x:Name="PasswordInput" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" />

      <TextBlock Grid.Row="4" Grid.Column="0" Text="SSL mode" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="SslModeComboBox" Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left" />
      <Button
        x:Name="TestButton"
        Grid.Row="4"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Content="Test connection"
        Padding="10,4"
        HorizontalAlignment="Right"
        Click="OnTestConnectionClick"
      />
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,0,0,14" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />

    <StackPanel Grid.Row="4" Margin="0,0,0,14">
      <Button
        x:Name="CancelChangeButton"
        Content="Cancel pending change"
        Visibility="Collapsed"
        HorizontalAlignment="Left"
        Padding="10,4"
        Margin="0,0,0,6"
        Click="OnCancelChangeClick"
      />
      <Button
        x:Name="UseLocalButton"
        Content="Use local without copying"
        Visibility="Collapsed"
        HorizontalAlignment="Left"
        Padding="10,4"
        Click="OnUseLocalClick"
      />
    </StackPanel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Exit" Width="82" Margin="0,0,8,0" IsCancel="True" />
      <Button x:Name="ContinueButton" Content="Continue" Width="100" IsDefault="True" Click="OnContinueClick" />
    </StackPanel>
  </Grid>
</Window>
