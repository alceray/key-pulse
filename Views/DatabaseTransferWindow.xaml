<Window
  x:Class="KeyPulse.Views.DatabaseTransferWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Style="{StaticResource AppWindowStyle}"
  Width="440"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterScreen"
>
  <StackPanel Margin="24">
    <TextBlock x:Name="StatusText" Text="Preparing database..." FontSize="18" />
    <TextBlock
      Text="KeyPulse will open when the database is ready."
      Foreground="{DynamicResource SecondaryTextBrush}"
      TextWrapping="Wrap"
      Margin="0,8,0,18"
    />
    <ProgressBar IsIndeterminate="True" Height="6" Foreground="{DynamicResource PrimaryTextBrush}" />
    <Button x:Name="CancelButton" Content="Stop and exit" HorizontalAlignment="Right" Padding="12,4" Margin="0,20,0,0" Click="OnCancelClick" />
  </StackPanel>
</Window>
